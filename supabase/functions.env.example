# Copy to ignored .env.functions.local in the project root; set through Supabase secrets.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by hosted Edge Functions.
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=
# Only enable in a separate sandbox/test project.
ALLOW_SANDBOX_PURCHASES=false
EXPO_ACCESS_TOKEN=
PUSH_WORKER_SECRET=
# Optional Stripe Connect implementation; confirm business/recipient country eligibility.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_COUNTRY=
PAYOUT_RETURN_URL=
