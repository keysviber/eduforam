{
  "expo": {
    "name": "Education Forum",
    "slug": "education-forum",
    "scheme": "educationforum",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.educationforum.app"
    },
    "android": {
      "package": "com.educationforum.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-v2.png",
        "backgroundColor": "#2c5542"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Education Forum"
    },
    "plugins": [
      "expo-document-picker",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2c5542",
          "image": "./assets/icon-v2.png",
          "imageWidth": 180
        }
      ]
    ],
    "icon": "./assets/icon-v2.png",
    "backgroundColor": "#fafbf7"
  }
}
