EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Published owner-operated pages required by the production build.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
# EAS project UUID after linking this app to your Expo account.
EAS_PROJECT_ID=

# Public web origin; also allowlist this URL in Supabase Authentication.
EXPO_PUBLIC_AUTH_REDIRECT_URL=

# Native purchases: RevenueCat PUBLIC platform SDK keys (never secret REST keys).
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REMOVE_ADS_PRODUCT=remove_ads

# Native ads stay off until accounts, consent messages, and test builds are ready.
EXPO_PUBLIC_ADS_ENABLED=false
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER=
EXPO_PUBLIC_ADMOB_IOS_BANNER=
EXPO_PUBLIC_ADMOB_ANDROID_NATIVE=
EXPO_PUBLIC_ADMOB_IOS_NATIVE=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED=
EXPO_PUBLIC_ADMOB_IOS_REWARDED=
# EAS file variable/path for Firebase Android push credentials configuration.
GOOGLE_SERVICES_JSON=

# Deployment only: keep the real value in ignored .env.local, never EXPO_PUBLIC_*.
SUPABASE_ACCESS_TOKEN=
