EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Published owner-operated pages required by the production build.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
# EAS project UUID after linking this app to your Expo account.
EAS_PROJECT_ID=

# Public web origin; also allowlist this URL in Supabase Authentication.
EXPO_PUBLIC_AUTH_REDIRECT_URL=

# Native purchases: RevenueCat PUBLIC platform SDK keys (never secret REST keys).
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REMOVE_ADS_PRODUCT=remove_ads

# Android AdMob configuration. Development builds always use test ad units.
EXPO_PUBLIC_ADS_ENABLED=true
EXPO_PUBLIC_ADS_TEST_MODE=false
ADMOB_ANDROID_APP_ID=ca-app-pub-5159886736355105~6496716381
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER=ca-app-pub-5159886736355105/7119532918
EXPO_PUBLIC_ADMOB_IOS_BANNER=
EXPO_PUBLIC_ADMOB_ANDROID_NATIVE=ca-app-pub-5159886736355105/9402915472
EXPO_PUBLIC_ADMOB_IOS_NATIVE=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED=ca-app-pub-5159886736355105/4720514569
EXPO_PUBLIC_ADMOB_IOS_REWARDED=
# EAS file variable/path for Firebase Android push credentials configuration.
GOOGLE_SERVICES_JSON=

# Deployment only: keep the real value in ignored .env.local, never EXPO_PUBLIC_*.
SUPABASE_ACCESS_TOKEN=

# Deployment-only custom email provider settings; use ignored .env.local.
# Verify the sender domain with your provider before applying these settings.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Education Forum
# Choose a sending limit supported by your provider/account.
AUTH_EMAILS_PER_HOUR=
# Optional public HTTPS web app for invitation/video links. Without it, links
# use educationforum://open and require the installed app.
# Intended website: https://eduforum.co.zw/ (enable after DNS/hosting is live).
EXPO_PUBLIC_SHARE_BASE_URL=

# Server-only study assistant credentials. Set these as Supabase Edge Function secrets.
# Never use an EXPO_PUBLIC_ prefix for provider secrets.
OPENAI_API_KEY=
STUDY_AI_MODEL=gpt-4.1-mini

# Optional Gemini provider; never include these secrets in client code.
GEMINI_API_KEY=
STUDY_AI_PROVIDER=gemini
STUDY_GEMINI_MODEL=gemini-3.5-flash-lite

EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=ca-app-pub-5159886736355105/6198167631
